    "express": "^5.2.1",
    "hamper": "^0.0.1",
    "lucide-react": "^1.43.0",
    "mongodb": "^6.21.0",
    "mpill": "^0.5.1",
    "pug": "^3.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "restify": "^11.1.0",
    "sendgrid": "^5.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "underscore": "^1.13.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-cssnano": "^2.1.3",
    "gulp-jshint": "^2.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "jshint": "^2.13.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
