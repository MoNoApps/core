{
  "name": "core",
  "private": true,
  "version": "4.0.0",
  "description": "Core",
  "main": "app.js",
  "scripts": {
    "dev": "node --watch app.js",
    "dev:client": "vite",
    "build:client": "vite build",
    "build": "tsc --noEmit && vite build",
    "test": "NODE_ENV=test tsx --test --test-force-exit 'test/*.test.ts'",
    "test:coverage": "NODE_ENV=test tsx --test --test-force-exit --experimental-test-coverage 'test/*.test.ts'",
    "test:coverage:lcov": "mkdir -p coverage && NODE_ENV=test tsx --test --test-force-exit --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx migrations/seed.ts",
    "seed": "tsx migrations/seed.ts",
    "seed:products": "tsx migrations/seed_products.ts",
    "create:user": "tsx scripts/create_user.ts",
    "create:admin": "tsx scripts/create_user.ts --role admin",
    "create:viewer": "tsx scripts/create_user.ts --role viewer",
    "validate:config": "tsx scripts/validate_config.ts",
    "start": "node app.js"
  },
  "author": "Core Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "async": "^3.2.6",
    "express": "^5.2.1",
    "lucide-react": "^1.43.0",
    "mongodb": "^6.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "tsx": "^4.23.12",
    "underscore": "^1.13.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
